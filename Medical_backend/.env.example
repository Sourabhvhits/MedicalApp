# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME="Medical Marketplace"
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://root:password@localhost:3306/medical_saas"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
PUBLIC_UPLOAD_BASE_URL=http://localhost:5000/uploads

# ---------------------------------------------------------------------------
# Redis (optional - caching disabled when empty)
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# Mail (optional - logged to console when empty)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Medical Marketplace <no-reply@example.com>"

# ---------------------------------------------------------------------------
# SMS (optional - logged to console when empty)
# ---------------------------------------------------------------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# ---------------------------------------------------------------------------
# Online payments (optional - "Pay online" stays hidden/rejected when empty,
# see backend/src/lib/payment-gateway.ts; PROVIDER e.g. "razorpay" or "stripe")
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Provider-key encryption (optional - only needed once an admin saves a
# provider key via /admin/settings' Integrations tab instead of env vars;
# generate with `openssl rand -hex 32`)
# ---------------------------------------------------------------------------
CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Business defaults
# ---------------------------------------------------------------------------
DEFAULT_SEARCH_RADIUS_KM=5
MAX_SEARCH_RADIUS_KM=50
ORDER_AUTO_EXPIRE_HOURS=24
ENABLE_CRON_JOBS=true

# ---------------------------------------------------------------------------
# Seed super admin
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@medsaas.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_PHONE=9000000001
