model Invoice {
  id              String        @id @default(uuid()) @db.Char(36)
  invoiceNumber   String        @unique @db.VarChar(32)
  type            InvoiceType
  ownerType       OwnerType
  vendorId        String?       @db.Char(36)
  retailerId      String?       @db.Char(36)
  orderId         String?       @unique @db.Char(36)
  purchaseOrderId String?       @unique @db.Char(36)
  billToName      String?       @db.VarChar(191)
  billToGst       String?       @db.VarChar(20)
  billToAddress   String?       @db.VarChar(500)
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount   Decimal       @default(0) @db.Decimal(12, 2)
  cgstAmount      Decimal       @default(0) @db.Decimal(12, 2)
  sgstAmount      Decimal       @default(0) @db.Decimal(12, 2)
  igstAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  pdfUrl          String?       @db.VarChar(500)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  retailer      Retailer?      @relation(fields: [retailerId], references: [id])
  order         Order?         @relation(fields: [orderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  payments      Payment[]

  @@index([ownerType, vendorId, retailerId])
  @@index([invoiceDate])
  @@map("invoices")
}

model Payment {
  id              String           @id @default(uuid()) @db.Char(36)
  paymentNumber   String           @unique @db.VarChar(32)
  ownerType       OwnerType
  vendorId        String?          @db.Char(36)
  retailerId      String?          @db.Char(36)
  invoiceId       String?          @db.Char(36)
  orderId         String?          @db.Char(36)
  purchaseOrderId String?          @db.Char(36)
  direction       PaymentDirection
  mode            PaymentMode      @default(CASH)
  amount          Decimal          @db.Decimal(12, 2)
  status          PaymentStatus    @default(PAID)
  referenceNo     String?          @db.VarChar(120)
  paidAt          DateTime         @default(now())
  notes           String?          @db.VarChar(500)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  retailer      Retailer?      @relation(fields: [retailerId], references: [id])
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  order         Order?         @relation(fields: [orderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([ownerType, vendorId, retailerId])
  @@index([paidAt])
  @@index([invoiceId])
  @@index([orderId])
  @@index([purchaseOrderId])
  @@map("payments")
}

enum ExpenseStatus {
  PENDING
  PAID
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
  YEARLY
}

model Expense {
  id            String        @id @default(uuid()) @db.Char(36)
  ownerType     OwnerType
  vendorId      String?       @db.Char(36)
  retailerId    String?       @db.Char(36)
  category      String        @db.VarChar(80)
  title         String        @db.VarChar(191)
  amount        Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  expenseDate   DateTime      @db.Date
  paymentMode   PaymentMode   @default(CASH)
  notes         String?       @db.VarChar(500)
  attachmentUrl String?       @db.VarChar(500)
  status        ExpenseStatus @default(PAID)
  createdById   String?       @db.Char(36)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Recurring template fields — only meaningful when isRecurring is true, on
  // the original row the business created. Auto-generated occurrences carry
  // isRecurring=false and point back via parentExpenseId instead.
  isRecurring          Boolean             @default(false)
  recurrenceInterval   RecurrenceInterval?
  nextRecurrenceDate   DateTime?           @db.Date
  recurrenceCancelledAt DateTime?
  parentExpenseId      String?             @db.Char(36)

  vendor        Vendor?   @relation(fields: [vendorId], references: [id])
  retailer      Retailer? @relation(fields: [retailerId], references: [id])
  parentExpense Expense?  @relation("ExpenseRecurrence", fields: [parentExpenseId], references: [id])
  recurrences   Expense[] @relation("ExpenseRecurrence")

  @@index([ownerType, vendorId, retailerId, expenseDate])
  @@index([isRecurring, nextRecurrenceDate])
  @@map("expenses")
}

model FinanceTransaction {
  id            String           @id @default(uuid()) @db.Char(36)
  ownerType     OwnerType
  vendorId      String?          @db.Char(36)
  retailerId    String?          @db.Char(36)
  type          FinanceTxnType
  direction     PaymentDirection
  amount        Decimal          @db.Decimal(12, 2)
  taxAmount     Decimal          @default(0) @db.Decimal(12, 2)
  referenceType String?          @db.VarChar(40)
  referenceId   String?          @db.Char(36)
  partyName     String?          @db.VarChar(191)
  description   String?          @db.VarChar(500)
  txnDate       DateTime         @default(now())
  createdAt     DateTime         @default(now())

  vendor   Vendor?   @relation(fields: [vendorId], references: [id])
  retailer Retailer? @relation(fields: [retailerId], references: [id])

  @@index([ownerType, vendorId, retailerId, txnDate])
  @@index([referenceType, referenceId])
  @@map("finance_transactions")
}

// ---------------------------------------------------------------------------
// ENGAGEMENT & PLATFORM
// ---------------------------------------------------------------------------

model Notification {
  id        String              @id @default(uuid()) @db.Char(36)
  userId    String              @db.Char(36)
  channel   NotificationChannel @default(IN_APP)
  event     String              @db.VarChar(60)
  title     String              @db.VarChar(191)
  body      String              @db.Text
  data      Json?
  status    NotificationStatus  @default(QUEUED)
  readAt    DateTime?
  sentAt    DateTime?
  error     String?             @db.VarChar(500)
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
  @@map("notifications")
}

/**
 * Platform-wide default vs. a single vendor's/retailer's override for one event.
 */
enum TemplateScope {
  PLATFORM
  VENDOR
  RETAILER
}

/**
 * Customisable title/body per notification `event` (TASKS.md #15). A
 * PLATFORM row is the admin-set default; a VENDOR/RETAILER row for the same
 * event overrides it for that one business. `notify()` resolves store scope
 * before platform scope, falling back to the caller's hardcoded copy if
 * neither row exists, so this is additive — nothing breaks if no template is
 * ever configured. `{{placeholders}}` in title/body are filled from the
 * `data` payload already passed to `notify()`.
 */
model NotificationTemplate {
  id            String        @id @default(uuid()) @db.Char(36)
  event         String        @db.VarChar(60)
  scope         TemplateScope
  vendorId      String?       @db.Char(36)
  retailerId    String?       @db.Char(36)
  titleTemplate String        @db.VarChar(191)
  bodyTemplate  String        @db.VarChar(1000)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  vendor   Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  retailer Retailer? @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@index([event, scope])
  @@index([vendorId])
  @@index([retailerId])
  @@map("notification_templates")
}

enum BroadcastSegment {
  ALL_VENDORS
  ALL_RETAILERS
  ALL_CUSTOMERS
  EVERYONE
}

/**
 * History of admin mass-messages — the fan-out itself reuses `notify()`
 * per recipient (same as `notifyAdmins()`), this just records that it
 * happened, to whom, and how many.
 */
model Broadcast {
  id             String           @id @default(uuid()) @db.Char(36)
  segment        BroadcastSegment
  title          String           @db.VarChar(191)
  body           String           @db.Text
  channels       Json
  recipientCount Int              @default(0)
  sentById       String           @db.Char(36)
  createdAt      DateTime         @default(now())

  @@index([createdAt])
  @@map("broadcasts")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Char(36)
  customerId String   @db.Char(36)
  retailerId String?  @db.Char(36)
  productId  String?  @db.Char(36)
  createdAt  DateTime @default(now())

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  retailer Retailer? @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, retailerId, productId])
  @@index([retailerId])
  @@index([productId])
  @@map("favorites")
}

model Review {
  id         String   @id @default(uuid()) @db.Char(36)
  customerId String   @db.Char(36)
  retailerId String   @db.Char(36)
  orderId    String?  @db.Char(36)
  rating     Int
  comment    String?  @db.VarChar(1000)
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  @@index([retailerId, isVisible])
  @@index([customerId])
  @@map("reviews")
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String?   @db.Char(36)
  userType  UserType?
  action    String    @db.VarChar(80)
  module    String    @db.VarChar(60)
  recordId  String?   @db.VarChar(64)
  oldValue  Json?
  newValue  Json?
  ipAddress String?   @db.VarChar(64)
  userAgent String?   @db.VarChar(255)
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([module, recordId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id        String   @id @default(uuid()) @db.Char(36)
  key       String   @unique @db.VarChar(120)
  value     String   @db.Text
  group     String   @default("general") @db.VarChar(60)
  dataType  String   @default("string") @db.VarChar(20)
  label     String?  @db.VarChar(191)
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

enum ProviderKind {
  SMS
  EMAIL
  PAYMENT_GATEWAY
}

/**
 * Admin-managed provider keys (TASKS.md #16) — SMS/email/payment-gateway
 * credentials, kept separate from the plain-text `Setting` table above
 * because these are encrypted at rest. `config` holds the provider's whole
 * field set as one AES-256-GCM ciphertext (`lib/crypto.ts`); the app never
 * stores it in plain JSON. Falls back to the equivalent `.env` values
 * (`lib/sms.ts`/`lib/mailer.ts`/`lib/payment-gateway.ts`) when no active row
 * exists for a provider, so nothing breaks for a deployment that only ever
 * used env vars.
 */
model ProviderCredential {
  id              String       @id @default(uuid()) @db.Char(36)
  provider        ProviderKind @unique
  encryptedConfig String       @db.Text
  isActive        Boolean      @default(true)
  updatedById     String?      @db.Char(36)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("provider_credentials")
}
